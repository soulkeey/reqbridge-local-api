meta {
  name: Create Refund Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v2/orders/{{orderId}}/refund
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Request-Source: bruno-single
  ~X-Disabled-Header: ignore-me
}

query {
  dryRun: false
}

auth:bearer {
  token: {{apiToken}}
}

body:json {
  {
    "orderId": "{{orderId}}",
    "reason": "duplicate_charge"
  }
}

assert {
  res.status: eq 201
}
