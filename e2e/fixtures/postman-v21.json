{
  "info": {
    "name": "ReqBridge E2E Orders Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8787" },
    { "key": "apiToken", "value": "test_token_placeholder" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{apiToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/v2/orders?status=paid&limit=10",
              "query": [
                { "key": "status", "value": "paid" },
                { "key": "limit", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout",
          "item": [
            {
              "name": "Create Checkout Session",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\"plan\":\"personal\",\"currency\":\"USD\"}"
                },
                "url": {
                  "raw": "{{baseUrl}}/v2/checkout"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Checkout created\", function () { pm.response.to.have.status(201); });"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":\"{{orderId}}\",\"customer\":\"{{customer}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/v2/orders"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order created\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health Public",
      "request": {
        "method": "GET",
        "auth": { "type": "noauth" },
        "url": {
          "raw": "{{baseUrl}}/health"
        }
      }
    }
  ]
}
